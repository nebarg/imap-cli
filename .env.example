# Copy to .env and fill in. .env is gitignored.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=you@example.com
# For Gmail/Outlook use an app-specific password, not your account password.
IMAP_PASSWORD=your-app-specific-password
# true  = implicit TLS (port 993)
# false = STARTTLS (port 143)
IMAP_TLS=true

# Multiple accounts (optional): prefix with the account name, then select it
# with `--account work`. Unset values fall back to the defaults above.
# IMAP_WORK_HOST=imap.fastmail.com
# IMAP_WORK_USERNAME=you@work.com
# IMAP_WORK_PASSWORD=...
